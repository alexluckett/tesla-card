{
  "name": "tesla-card",
  "version": "0.1.0",
  "description": "Home Assistant dashboard card for vehicles on the Tesla Fleet integration",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "test": "node --test test/",
    "lint": "eslint src test",
    "format": "prettier --check src test",
    "format:write": "prettier --write src test",
    "verify": "npm run lint && npm run format && npm test && npm run build"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rollup": "^4.30.1"
  }
}
